# LifeVault environment configuration
# Copy this file to `.env` and replace every placeholder. NEVER commit `.env`.

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me
# IANA timezone that defines "today" and month boundaries on the dashboard.
APP_TIMEZONE=Asia/Kathmandu

# --- URLs ------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Optional comma-separated extra CORS origins (e.g. http://127.0.0.1:5173)
CORS_EXTRA_ORIGINS=

# --- PostgreSQL (used by Docker Compose to create the database) ---------------
POSTGRES_USER=lifevault
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=lifevault
# Host port the Compose database is published on (bound to 127.0.0.1 only).
# Change it if a local PostgreSQL already uses 5432.
POSTGRES_HOST_PORT=5432

# Connection string used by the backend when running OUTSIDE Docker.
# Inside Docker Compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+psycopg://lifevault:change-me-db-password@localhost:5432/lifevault

# --- Authentication --------------------------------------------------------------
# LifeVault is private: set to false once your own account exists.
REGISTRATION_ENABLED=true
# MUST be true when served over HTTPS (required in production).
COOKIE_SECURE=false
# Sign out after this many minutes of inactivity (sessions without "remember me").
SESSION_IDLE_TIMEOUT_MINUTES=480
# Absolute session lifetime without / with "remember me".
SESSION_LIFETIME_HOURS=12
SESSION_REMEMBER_ME_DAYS=30
PASSWORD_RESET_TOKEN_MINUTES=30
RATE_LIMIT_ENABLED=true
# Only true behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Email (password reset) ---------------------------------------------------------
# dev_outbox = development only: emails are saved as .eml files in backend/var/dev-outbox/
# smtp       = production: configure the SMTP_* values below
# disabled   = no emails (reset links can't be delivered)
EMAIL_BACKEND=dev_outbox
EMAIL_FROM=LifeVault <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Password vault ----------------------------------------------------------------
# Master key that encrypts every user's vault data key. 32 random bytes, base64 (urlsafe).
# Keep it OUT of the database and its backups, and back it up separately and safely:
# losing it makes all vault entries unrecoverable. Required in production.
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_VERSION=1
# Minutes the vault stays unlocked after re-entering your password.
VAULT_UNLOCK_MINUTES=10

# --- Documents -------------------------------------------------------------------
# Private upload storage (outside any web root). Relative paths resolve from where the API runs.
# DOCUMENT_STORAGE_DIR=backend/var/documents
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_QUOTA_BYTES=1073741824

# --- Frontend (Vite) -------------------------------------------------------------
# Where the Vite dev server proxies /api requests. Inside Docker this is http://backend:8000.
VITE_API_PROXY_TARGET=http://localhost:8000
